POSTGRES_USER=b2b_radar
POSTGRES_PASSWORD=change-me-for-production
POSTGRES_DB=b2b_radar
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
WEB_PORT=8000

# Optional read-only stage-13 public ML snapshot
ML_RESULTS_ENABLED=false
ML_EXPORT_MANIFEST=data/processed/export/export-manifest.json
# Development-only: expose preliminary/failed results with their quality warning.
ML_ALLOW_UNRELIABLE=false

# Caddy reverse proxy (production deployment)
DOMAIN=example.com
BASIC_AUTH_USER=admin
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
BASIC_AUTH_HASH=
# Required by the Cloudflare-enabled Caddy image for DNS-01 TLS challenges.
CLOUDFLARE_API_TOKEN=
